# ---- Required in production -------------------------------------------------
NODE_ENV=production
PORT=4000
MONGO_URI=mongodb://127.0.0.1:27017/nanoskool
# Generate with: openssl rand -hex 64
JWT_ACCESS_SECRET=
# Browser origins allowed to call the API (comma separated)
CORS_ORIGINS=https://app.nanoskool.in
# Used in invite and password-reset links
APP_URL=https://app.nanoskool.in
PUBLIC_API_URL=
COOKIE_SECURE=true

# ---- Sessions ----------------------------------------------------------------
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_DAYS=30

# ---- Email (leave SMTP_HOST empty to print emails to the log) -----------------
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=Nanoskool <no-reply@nanoskool.in>

# ---- File storage: local (./uploads) or s3 (any S3-compatible bucket, e.g. Vultr) ----
STORAGE_DRIVER=local
UPLOAD_DIR=uploads
MAX_UPLOAD_MB=25
S3_ENDPOINT=https://blr1.vultrobjects.com
S3_REGION=blr1
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_URL=

# ---- NanoBot AI tutor: mock | nanobot | anthropic ----------------------------
AI_PROVIDER=mock
AI_DEFAULT_MONTHLY_TOKENS=200000
# nanobot: forwards to the existing chatbot service
NANOBOT_URL=https://chatbot.nanoskool.in
NANOBOT_SERVICE_SECRET=
# anthropic: calls the Claude API directly
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5

# ---- Migration from v1 (only for npm run migrate:legacy) ----------------------
LEGACY_MONGO_URI=
