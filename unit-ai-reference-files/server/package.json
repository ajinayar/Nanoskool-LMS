{
  "name": "nanoskool-api",
  "version": "2.0.0",
  "description": "Nanoskool LMS API (v2)",
  "scripts": {
    "dev": "tsc -p tsconfig.json && node --watch dist/index.js",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "seed": "tsc -p tsconfig.json && node dist/seed.js",
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "migrate:legacy": "tsc -p tsconfig.json && node dist/scripts/migrate-legacy.js",
    "dev:tsx": "tsx watch src/index.ts",
    "demo:grades": "tsc -p tsconfig.json && node dist/demoGrades.js",
    "demo:journey": "tsc -p tsconfig.json && node dist/demoJourney.js"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1141.0",
    "bcryptjs": "^3.0.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^18.0.4",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.0",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "jszip": "^3.10.2",
    "mongoose": "^8.24.4",
    "multer": "^2.4.0",
    "nodemailer": "^10.0.11",
    "pdfkit": "^0.17.2",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "sanitize-html": "^2.17.7",
    "unpdf": "^1.8.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^2.2.0",
    "@types/node": "^22.20.4",
    "@types/nodemailer": "^8.0.2",
    "@types/pdfkit": "^0.17.6",
    "@types/sanitize-html": "^2.16.1",
    "@types/supertest": "^7.2.1",
    "pino-pretty": "^13.1.3",
    "supertest": "^7.3.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.2"
  },
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  }
}
